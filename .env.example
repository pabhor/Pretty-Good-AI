# ============================================================
# Pretty Good AI — Voice Bot Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.
# ============================================================

# Twilio — telephony, recording, STT (via Gather)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx      # your Twilio outbound number

# Target — DO NOT change this; calls only go here
TARGET_PHONE=+18054398008

# OpenAI — LLM (GPT-4o-mini) + TTS (tts-1 / onyx voice)
OPENAI_API_KEY=sk-proj-...

# Deepgram — post-call transcription (Nova-2 with diarization)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ngrok — exposes local Flask server to Twilio webhooks
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
